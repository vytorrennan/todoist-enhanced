{
  "name": "todoist-enhancements",
  "private": true,
  "version": "2.37.0",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "description": "An independent project, not created by, affiliated with, or supported by Todoist. A different front end built around planning a week.",
  "scripts": {
    "dev": "vite",
    "server": "tsx watch --tsconfig tsconfig.server.json server/index.ts",
    "start": "node dist-server/index.mjs",
    "build": "tsc -b && vite build",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist-server/index.mjs --log-level=warning",
    "icons": "node scripts/make-icons.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "test:mcp": "npm run build:server && npm --prefix mcp-e2e test",
    "package": "npm run build && node scripts/package.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:release": "PLAYWRIGHT_DEV=1 playwright test",
    "test:server": "vitest run server"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hugeicons/core-free-icons": "^4.4.0",
    "@hugeicons/react": "^1.1.10",
    "better-sqlite3": "^12.11.1",
    "busboy": "^1.6.0",
    "date-fns": "^4.1.0",
    "emojibase-data": "17.0.0",
    "idb": "^8.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@todoist/sdk": "^24.1.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/busboy": "^1.5.5",
    "@types/node": "^26.5.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "lucide-react": "^1.47.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^6.0.11",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "@codemirror/language": "6.12.4"
  }
}
